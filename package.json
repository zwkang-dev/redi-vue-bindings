{
  "name": "@zwkang-dev/redi-vue-binding",
  "type": "module",
  "version": "0.0.1-beta.15",
  "packageManager": "pnpm@10.29.2",
  "description": "a simple redi vue adaptor",
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "zwkang",
    "email": "kang95630@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zwkang-dev/redi-vue-bindings"
  },
  "bugs": "https://github.com/zwkang-dev/redi-vue-bindings/issues",
  "keywords": [],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": ["./dist/index.d.ts"]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "build": "tsup",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "update:deps": "taze major -lr",
    "changelog": "npx changelogithub --dry",
    "changelog:generate": "npx changelogithub",
    "release": "npm publish",
    "release:beta": "bumpp --preid beta --tag beta && npm publish --tag beta",
    "release:major": "bumpp major && npm publish",
    "release:minor": "bumpp minor && npm publish",
    "release:patch": "bumpp patch && npm publish",
    "bump:version": "bumpp"
  },
  "peerDependencies": {
    "@wendellhu/redi": ">=1.0.0",
    "@vueuse/core": ">=9.0.0",
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@types/node": "^22.19.10"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.3.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.2.0",
    "@wendellhu/redi": "^1.1.1",
    "bumpp": "^10.4.1",
    "eslint": "^10.0.0",
    "happy-dom": "^20.5.3",
    "taze": "^19.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.27"
  }
}
