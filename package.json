    "update:deps": "taze major -lr"
  },
  "peerDependencies": {
    "@vueuse/core": ">=9.0.0",
    "@wendellhu/redi": "^0.15.4",
    "monaco-editor": ">=0.39.0",
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@types/node": "^22.17.2",
    "@wendellhu/redi": "^1.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "bumpp": "^10.2.3",
    "eslint": "^9.33.0",
    "taze": "^19.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
